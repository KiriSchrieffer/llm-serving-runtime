# Backend selection: mock | llama.cpp | vllm
LLM_RUNTIME_BACKEND=mock

# Scheduler: fifo | priority
LLM_RUNTIME_SCHEDULER=fifo
# Disabled by default; set >0 to let old low-priority requests age upward.
LLM_RUNTIME_PRIORITY_AGING_BOOST_INTERVAL_S=0

# Batching
LLM_RUNTIME_ENABLE_BATCHING=true
LLM_RUNTIME_MAX_BATCH_SIZE=8
LLM_RUNTIME_BATCH_TIMEOUT_MS=10
LLM_RUNTIME_REQUEST_TIMEOUT_S=120

# Mock backend latency simulation (ms)
LLM_RUNTIME_PREFILL_LATENCY_MS=25
LLM_RUNTIME_DECODE_LATENCY_MS=10

# Model path (used by llama.cpp and vLLM)
LLM_RUNTIME_MODEL_PATH=E:\llama.cpp\models\Qwen3-4B-Instruct-2507-Q4_K_M.gguf

# llama.cpp
LLM_RUNTIME_N_CTX=2048
LLM_RUNTIME_N_GPU_LAYERS=0

# vLLM
LLM_RUNTIME_VLLM_PORT=8082
LLM_RUNTIME_VLLM_GPU_MEMORY_UTILIZATION=0.9
# LLM_RUNTIME_VLLM_MAX_MODEL_LEN=4096
# LLM_RUNTIME_VLLM_COMMAND=vllm
